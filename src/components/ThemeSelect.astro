---
/**
 * Patina theme toggle — same auto/light/dark icons as johna.kiwi.
 * Cycles preference and writes Starlight's `starlight-theme` key so
 * ThemeProvider stays in sync.
 */
---

<starlight-theme-select>
  <button
    class="theme-toggle"
    type="button"
    aria-live="polite"
    title="Colour theme: system"
    hidden
  >
    <svg class="icon theme-icon theme-icon-auto" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M12 2v2M14.837 16.385a6 6 0 1 1-7.223-7.222c.624-.147.97.66.715 1.248a4 4 0 0 0 5.26 5.259c.589-.255 1.396.09 1.248.715M16 12a4 4 0 0 0-4-4M19 5l-1.256 1.256M20 12h2"
      ></path>
    </svg>
    <svg class="icon theme-icon theme-icon-light" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
      ></path>
    </svg>
    <svg class="icon theme-icon theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
      ></path>
    </svg>
    <span class="visually-hidden">Colour theme: system</span>
  </button>
</starlight-theme-select>

<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  type Theme = "auto" | "dark" | "light";

  const storageKey = "starlight-theme";
  const modes: Theme[] = ["auto", "light", "dark"];
  const labels: Record<Theme, string> = {
    auto: "Colour theme: system",
    light: "Colour theme: light",
    dark: "Colour theme: dark",
  };

  const parseTheme = (theme: unknown): Theme =>
    theme === "auto" || theme === "dark" || theme === "light" ? theme : "auto";

  const loadTheme = (): Theme =>
    parseTheme(
      typeof localStorage !== "undefined" && localStorage.getItem(storageKey),
    );

  function storeTheme(theme: Theme): void {
    if (typeof localStorage === "undefined") return;
    localStorage.setItem(storageKey, theme === "light" || theme === "dark" ? theme : "");
  }

  const getPreferredColorScheme = (): Theme =>
    matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";

  function onThemeChange(theme: Theme): void {
    document.documentElement.dataset.theme =
      theme === "auto" ? getPreferredColorScheme() : theme;
    document.documentElement.dataset.themePref = theme;
    storeTheme(theme);
    StarlightThemeProvider.updatePickers(theme);

    document.querySelectorAll("starlight-theme-select .theme-toggle").forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const label = labels[theme];
      button.title = label;
      const sr = button.querySelector(".visually-hidden");
      if (sr) sr.textContent = label;
    });
  }

  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (loadTheme() === "auto") onThemeChange("auto");
  });

  class StarlightThemeSelect extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector(".theme-toggle");
      if (!(button instanceof HTMLButtonElement)) return;
      onThemeChange(loadTheme());
      button.hidden = false;
      button.addEventListener("click", () => {
        const next = modes[(modes.indexOf(loadTheme()) + 1) % modes.length];
        onThemeChange(next);
      });
    }
  }

  customElements.define("starlight-theme-select", StarlightThemeSelect);
</script>
